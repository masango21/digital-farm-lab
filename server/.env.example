# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed web origins (mobile apps don't need CORS). Use * in development.
CORS_ORIGINS=*

# ---- Neon PostgreSQL (free tier) ----
# Neon console -> your project -> Connection Details -> "Pooled connection" string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Code trainers must enter when registering (stops learners signing up as trainers)
TRAINER_INVITE_CODE=FARM-TRAINER-2026

# Checks the email domain has mail (MX) records before sign-up. Only set false for offline dev.
EMAIL_DNS_CHECK=true

# ---- Brevo email (free: 300 emails/day) ----
# Brevo -> SMTP & API -> API Keys. Sender email must be verified under Senders & IP.
BREVO_API_KEY=xkeysib-xxxxxxxx
EMAIL_FROM_ADDRESS=your-verified-sender@gmail.com
EMAIL_FROM_NAME=Digital Farm Lab
# Set to true to print emails to the console instead of sending (local dev without Brevo)
EMAIL_DEV_LOG_ONLY=false

# ---- Cloudinary (free tier) ----
# Cloudinary console -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx
CLOUDINARY_FOLDER=digital-farm-lab

# ---- AgriLearn Passport (microcredentials) ----
# Webhook that receives "microcredential.earned" events. Leave empty until AgriLearn provides one;
# events wait in the credential_events table and are sent once this is set.
AGRILEARN_WEBHOOK_URL=
# Shared secret: each event is signed as X-DFL-Signature: sha256=<HMAC-SHA256 of the body>
AGRILEARN_WEBHOOK_SECRET=change-me
# Minimum score for a reflected run to earn a scenario's microcredential
CREDENTIAL_MIN_SCORE=70

# ---- Share links ----
# Public URL of this API for shareable result links. Empty = use the request's host.
PUBLIC_BASE_URL=
